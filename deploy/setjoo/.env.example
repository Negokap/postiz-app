# Setjoo Social (Postiz) — copy to .env. Never commit .env.

# --- URLs. Local values shown; production is https://social.setjoo.com
MAIN_URL=http://127.0.0.1:5028
FRONTEND_URL=http://127.0.0.1:5028
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5028/api

# --- Secrets (generate each with: openssl rand -hex 32)
JWT_SECRET=
POSTIZ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=

# --- Setjoo Identity login (client "setjoo-social" in setjoo/shared/registry.ts).
# Must equal SETJOO_CLIENT_SECRET_SOCIAL in Setjoo Identity's env.
POSTIZ_OAUTH_CLIENT_SECRET=
# The browser goes to AUTH_URL; the Postiz server calls TOKEN and USERINFO.
# Local: the container reaches the host's Identity through host.docker.internal.
# Production: all three are https://auth.setjoo.com/oauth/...
POSTIZ_OAUTH_URL=http://127.0.0.1:5006
POSTIZ_OAUTH_AUTH_URL=http://127.0.0.1:5006/oauth/authorize
POSTIZ_OAUTH_TOKEN_URL=http://host.docker.internal:5006/oauth/token
POSTIZ_OAUTH_USERINFO_URL=http://host.docker.internal:5006/oauth/userinfo

# --- Media storage. Production must use S3-compatible storage, not local disk.
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto

# --- Social networks. Each needs its own developer app (see setjoo docs/SETJOO_SOCIAL.md).
# Bluesky needs nothing here: it connects with a handle + app password in the UI.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=

# --- Optional
OPENAI_API_KEY=
API_LIMIT=30
# Billing is owned by Setjoo Payments; leave Stripe empty.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
